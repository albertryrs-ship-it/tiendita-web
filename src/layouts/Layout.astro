---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
}

const props = Astro.props;

const siteJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${site.parent.url}/#organization`,
		name: site.parent.name,
		url: site.parent.url,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${site.url}/#website`,
		name: site.name,
		url: `${site.url}/`,
		inLanguage: site.locale,
		publisher: { '@id': `${site.parent.url}/#organization` },
	},
];
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" id="theme-color" content="#ffffff" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		{
			/*
				Tema + menú. En línea y antes del primer pintado para evitar el parpadeo de tema
				y para que la clase "js" y los manejadores existan a la vez (ver Header/ThemeToggle).
				Delegación de eventos: no depende de que el DOM ya exista.
			*/
		}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var KEY = 'theme';
				var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

				function stored() {
					try {
						var t = localStorage.getItem(KEY);
						return t === 'light' || t === 'dark' ? t : null;
					} catch (err) {
						return null;
					}
				}
				function current() {
					return root.dataset.theme || (darkQuery.matches ? 'dark' : 'light');
				}
				function sync() {
					var dark = current() === 'dark';
					var meta = document.getElementById('theme-color');
					if (meta) meta.setAttribute('content', dark ? '#0a0a0a' : '#ffffff');
					var label = dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';
					document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
						b.setAttribute('aria-label', label);
						var text = b.querySelector('.label');
						if (text) text.textContent = label;
					});
				}
				function setMenu(open) {
					root.classList.toggle('menu-open', open);
					var btn = document.querySelector('[data-menu-toggle]');
					if (btn) btn.setAttribute('aria-expanded', String(open));
					return btn;
				}

				var saved = stored();
				if (saved) root.dataset.theme = saved;
				root.classList.add('js');

				document.addEventListener('DOMContentLoaded', sync);
				if (darkQuery.addEventListener) darkQuery.addEventListener('change', sync);

				document.addEventListener('click', function (e) {
					var target = e.target;
					if (!(target instanceof Element)) return;

					if (target.closest('[data-theme-toggle]')) {
						var next = current() === 'dark' ? 'light' : 'dark';
						var apply = function () {
							root.dataset.theme = next;
							try {
								localStorage.setItem(KEY, next);
							} catch (err) {}
							sync();
						};
						// Fundido entre temas: los degradados de las bandas no se animan con transition,
						// así que se cruza toda la página con View Transitions (si hay soporte).
						var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						if (document.startViewTransition && !reduce) {
							document.startViewTransition(apply);
						} else {
							apply();
						}
						return;
					}
					if (target.closest('[data-menu-toggle]')) {
						setMenu(!root.classList.contains('menu-open'));
						return;
					}
					if (root.classList.contains('menu-open') && target.closest('#site-nav a')) {
						setMenu(false);
					}
				});

				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && root.classList.contains('menu-open')) {
						var btn = setMenu(false);
						if (btn) btn.focus();
					}
				});
			})();
		</script>

		<Font cssVariable="--font-brand" preload={[{ style: 'normal' }]} />
		<SEO {...props} />
		<JsonLd data={siteJsonLd} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<Header />
		<main id="contenido" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
